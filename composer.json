{
    "require-dev": {
        "matthiasmullie/minify": "^1.3",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.3",
        "wp-cli/wp-cli": "^2.12",
        "wp-cli/i18n-command": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cbf": "phpcbf",
        "make-pot": "wp i18n make-pot . languages/simple-honeypot-cf7.pot --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/pushpasta/simple-honeypot-cf7/issues\"}'",
        "locales-yml": "php .github/scripts/generate-locale-options.php",
        "minify:css": "php .github/scripts/minify-assets.php resources/admin/css/admin.css resources/admin/css/admin.min.css",
        "minify:js": [
            "php .github/scripts/minify-assets.php resources/admin/js/admin.js resources/admin/js/admin.min.js",
            "php .github/scripts/minify-assets.php resources/frontend/js/token-fetch.js resources/frontend/js/token-fetch.min.js"
        ],
        "minify": [
            "@minify:css",
            "@minify:js"
        ]
    }
}
